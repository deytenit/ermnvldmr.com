{
  "include": ["packages/**/*", "services/**/*"],
  "exclude": [
    "dist",
    "coverage",
    "node_modules",
    "**/dist",
    "**/coverage",
    "**/node_modules",
    ".config/**/*",
    "eslint.config.mjs"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@ermnvldmr/kits": ["./packages/kits/src"],
      "@ermnvldmr/kits/*": ["./packages/kits/src/*"],
      "@ermnvldmr/stl": ["./packages/stl/src"],
      "@ermnvldmr/stl/*": ["./packages/stl/src/*"],
      "@ermnvldmr/ui": ["./packages/ui/src"],
      "@ermnvldmr/ui/*": ["./packages/ui/src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true
  }
}
