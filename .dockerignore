# Docker build context optimization
# Exclude development and build artifacts

# Version control
!.git/
.gitignore

# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs (will be copied specifically in Dockerfiles)
dist/
storybook-static/
.astro/

# Development files
.env*
!.env.example

# Testing
coverage/
test-results/
playwright-report/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Documentation (not needed in container)
docs/
*.md
!README.md

# GitHub workflows and config
.github/

# Temporary files
tmp/
temp/

# Cache directories
.cache/
.eslintcache
.stylelintcache

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
jspm_packages/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity
