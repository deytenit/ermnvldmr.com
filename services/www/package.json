{
  "name": "@ermnvldmr/www",
  "version": "1.0.0",
  "description": "www.ermnvldmr.com website",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "test-storybook --coverage --config-dir .config/storybook",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm run test:storybook\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "rm -rf dist .turbo node_modules coverage storybook-static",
    "storybook": "storybook dev -p 6006 -c .config/storybook",
    "storybook:preview": "http-server storybook-static --port 6006",
    "build-storybook": "storybook build -c .config/storybook"
  },
  "dependencies": {
    "@ermnvldmr/stl": "workspace:*",
    "@ermnvldmr/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@ermnvldmr/eslint-config": "workspace:*",
    "@ermnvldmr/rsbuild-config": "workspace:*",
    "@ermnvldmr/storybook-config": "workspace:*",
    "@rsbuild/core": "^1.2.11",
    "@rsbuild/plugin-babel": "^1.1.0",
    "@rsbuild/plugin-mdx": "^1.1.1",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/addon-themes": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.19.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "*",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-istanbul": "^7.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "storybook": "^8.6.17",
    "storybook-react-rsbuild": "^1.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.3"
  }
}
