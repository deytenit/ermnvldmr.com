{
  "name": "@ermnvldmr/www",
  "version": "1.0.0",
  "description": "www.ermnvldmr.com website",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:storybook": "test-storybook --coverage",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm run test:storybook\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "rm -rf dist .turbo node_modules coverage storybook-static",
    "storybook": "storybook dev -p 6006",
    "storybook:preview": "http-server storybook-static --port 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.5",
    "@astrojs/react": "^4.2.5",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.1",
    "@ermnvldmr/stl": "workspace:*",
    "@ermnvldmr/ui": "workspace:*",
    "astro": "^5.7.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simplex-noise": "^4.0.3",
    "suncalc": "^1.9.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@ermnvldmr/eslint-config": "workspace:*",
    "@ermnvldmr/jest-config": "workspace:*",
    "@ermnvldmr/storybook-config": "workspace:*",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test-runner": "^0.19.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/suncalc": "^1.9.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "storybook": "^8.6.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^7.2.2",
    "vite-plugin-istanbul": "^7.2.1",
    "wait-on": "^8.0.3"
  }
}
