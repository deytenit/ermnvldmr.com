---
import { Container, Header, Paragraph, Link, VStack, List, Time, Text } from '@ermnvldmr/ui';
import { getCollection } from 'astro:content';

import IndexLayout from '#layouts/IndexLayout/IndexLayout.astro';
import { SITE_TITLE } from '#shared/constants';
import '#global.css';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.createdDate.valueOf() - a.data.createdDate.valueOf()
);
---

<IndexLayout title={`Articles | ${SITE_TITLE}`} description="Browse all articles and projects.">
  <Container as="main" className="mx-auto max-w-3xl px-6 py-20">
    <Header level={1} className="mb-12">Articles</Header>
    <List variant="plain" spacing="l">
      {
        articles.map((article) => (
          <List.Item>
            <Link href={`/articles/${article.id}`} className="group block no-underline!">
              <VStack gap={3} as="article">
                <Time
                  date={article.data.createdDate}
                  color="muted"
                  size="s"
                  type="label"
                />
                <Header
                  level={2}
                  className="group-hover:text-primary mt-0 border-none pb-0 text-3xl transition-colors"
                >
                  {article.data.title}
                </Header>
                {article.data.description && (
                  <Paragraph color="muted" size="l" maxLines={3}>
                    {article.data.description}
                  </Paragraph>
                )}
                {article.data.tags && (
                  <div class="flex gap-2">
                    {article.data.tags.map((tag) => (
                      <Text color="muted" size="s" className="before:content-['#']">
                        {tag}
                      </Text>
                    ))}
                  </div>
                )}
              </VStack>
            </Link>
          </List.Item>
        ))
      }
    </List>
  </Container>
</IndexLayout>
