---
import { VStack, HStack } from '@ermnvldmr/ui';

import StaticLayout from '#layouts/StaticLayout/StaticLayout.astro';
import {
  AUTHOR_EMAIL,
  AUTHOR_NAME,
  SITE_URL,
  ERROR_TITLE,
  ERROR_DESCRIPTION,
} from '#shared/constants';
import { getCurrentYear } from '#shared/utils';
import '#global.css';
---

<StaticLayout title={ERROR_TITLE} description={ERROR_DESCRIPTION}>
  <main class="h-screen w-screen">
    <VStack className="w-full h-full" align="center" justify="center">
      <VStack align="start" gap={8}>
        <h1 id="title">Exceptional Situation</h1>
        <p id="message">
          This location is unavailable at the moment — static content does not dwell here
        </p>
        <HStack justify="between" className="w-full">
          <span>
            <a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_NAME}</a>, {getCurrentYear()}
          </span>
          <span>
            <a href={SITE_URL}>ermnvldmr.com</a>
          </span>
        </HStack>
      </VStack>
    </VStack>
  </main>
  <script>
    import { getHttpStatusUrl } from '#shared/utils';

    function isNavigationTiming(
      entry: PerformanceEntry,
    ): entry is PerformanceNavigationTiming {
      return entry.entryType === 'navigation';
    }

    const navigationData = window.performance.getEntries().find(isNavigationTiming);

    if (navigationData?.responseStatus) {
      const { responseStatus } = navigationData;

      const link = document.createElement('a');
      link.href = getHttpStatusUrl(responseStatus);
      link.textContent = `#${responseStatus}`;

      document.getElementById('title')?.append(' ', link);
    }
  </script>
</StaticLayout>
