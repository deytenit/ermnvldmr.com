{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "#*": ["./*"],
      "@ermnvldmr/cli": ["../../../packages/cli/src"],
      "@ermnvldmr/cli/*": ["../../../packages/cli/src/*"],
      "@ermnvldmr/kits": ["../../../packages/kits/src"],
      "@ermnvldmr/kits/*": ["../../../packages/kits/src/*"],
      "@ermnvldmr/ssg": ["../../../packages/ssg/src"],
      "@ermnvldmr/ssg/*": ["../../../packages/ssg/src/*"],
      "@ermnvldmr/stl": ["../../../packages/stl/src"],
      "@ermnvldmr/ui": ["../../../packages/ui/src"],
      "@ermnvldmr/ui/*": ["../../../packages/ui/src/*"]
    }
  },
  "include": ["src/**/*", ".config/**/*"],
  "exclude": ["dist", "node_modules", "**/*.config.*"]
}
