{
  "name": "ermnvldmr.com",
  "version": "1.0.0",
  "description": "ermnvldmr.com monorepo",
  "author": "Vladimir Eremin <personal@ermnvldmr.com> (https://ermnvldmr.com)",
  "license": "GPL-2.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deytenit/ermnvldmr.com.git"
  },
  "bugs": {
    "url": "https://github.com/deytenit/ermnvldmr.com/issues"
  },
  "homepage": "https://github.com/deytenit/ermnvldmr.com#readme",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.12.3"
  },
  "scripts": {
    "ui:dev": "pnpm --filter @ermnvldmr/ui dev",
    "ui:build": "pnpm --filter @ermnvldmr/ui build",
    "ui:test": "pnpm --filter @ermnvldmr/ui test",
    "ui:storybook": "pnpm --filter @ermnvldmr/ui storybook",
    "www:dev": "pnpm --filter @ermnvldmr/www dev",
    "www:build": "pnpm --filter @ermnvldmr/www build",
    "www:storybook": "pnpm --filter @ermnvldmr/www storybook",
    "docs:dev": "pnpm --filter @ermnvldmr/docs dev",
    "docs:build": "pnpm --filter @ermnvldmr/docs build",
    "static:dev": "pnpm --filter @ermnvldmr/static dev",
    "static:build": "pnpm --filter @ermnvldmr/static build",
    "static:lint": "pnpm --filter @ermnvldmr/static lint",
    "static:typecheck": "pnpm --filter @ermnvldmr/static typecheck",
    "dev:ui": "pnpm ui:dev",
    "dev:www": "pnpm ui:build && pnpm www:dev",
    "dev:static": "pnpm ui:build && pnpm static:dev",
    "dev:docs": "pnpm docs:dev",
    "build": "pnpm ui:build && pnpm -r --filter='./services/*' build",
    "build:storybooks": "pnpm ui:build && pnpm --filter @ermnvldmr/ui build-storybook && pnpm --filter @ermnvldmr/www build-storybook",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "build:deps": "pnpm -r --filter='./packages/*-config' build && pnpm --filter='./packages/i18n' build"
  },
  "devDependencies": {
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@storybook/react-vite>vite": "^7.0.0",
      "@storybook/builder-vite>vite": "^7.0.0",
      "@joshwooding/vite-plugin-react-docgen-typescript>vite": "^7.0.0",
      "@tailwindcss/vite>vite": "^7.0.0",
      "vite-plugin-istanbul>vite": "^7.0.0"
    }
  }
}
